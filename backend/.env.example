# ── Required ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/formcraft"
# Direct (non-pooled) URL for migrations. Needed with Neon; leave unset for plain Postgres
# DATABASE_URL_UNPOOLED=""

# Long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"
PORT=3000

# ── Optional ────────────────────────────────────────────────
# OAuth: leave empty to disable the provider (email/password keeps working)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email alerts about new responses (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="FormCraft <noreply@example.com>"
